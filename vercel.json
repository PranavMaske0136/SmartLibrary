{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{website,chatbot}/**"
    },
    "server.js": {
      "includeFiles": "{website,chatbot}/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/website/index.html" }
  ]
}
